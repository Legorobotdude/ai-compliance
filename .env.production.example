# Production Environment Variables
# Copy this file to .env.production and fill in the values

# ============================================================================
# Database
# ============================================================================
POSTGRES_PASSWORD=your-secure-postgres-password

# ============================================================================
# Authentication & Authorization
# ============================================================================
AUTH_JWT_SECRET=your-secure-jwt-secret-min-32-chars
AUTH_ISSUER=https://auth.yourcompany.com
AUTH_AUDIENCE=certivo-api
AUTH_TENANT_CLAIM=tenant_id
AUTH_ROLES_CLAIM=roles
AUTH_EMAIL_CLAIM=email

# Optional: Use JWKS for production (recommended)
# AUTH_JWKS_URL=https://your-auth-provider.com/.well-known/jwks.json

# ============================================================================
# Temporal (Workflow Orchestration)
# ============================================================================
TEMPORAL_NAMESPACE=certivo-production
TEMPORAL_SUPPLIER_TASK_QUEUE=supplier-workflows
TEMPORAL_INGESTION_TASK_QUEUE=ingestion-retries

# ============================================================================
# CORA AI Service
# ============================================================================
CORA_OPENAI_API_KEY=sk-your-openai-api-key
CORA_OPENAI_MODEL=gpt-4o-mini
CORA_API_KEY=your-optional-cora-api-key

# ============================================================================
# Document Storage
# ============================================================================
DOCUMENTS_PUBLIC_BASE_URL=https://api.yourcompany.com
DOCUMENTS_SIGNING_SECRET=your-secure-document-signing-secret
DOCUMENTS_DOWNLOAD_TTL_MS=300000

# ============================================================================
# Web Application
# ============================================================================
CERTIVO_API_URL=http://api:4000
CERTIVO_API_TOKEN=your-api-token-from-generate-dev-token

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
