{
  "name": "Certivo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "bash ./scripts/dev.sh",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @certivo/lib-db migrate",
    "db:seed": "pnpm --filter @certivo/lib-db seed",
    "db:seed-user": "tsx ./libs/db/scripts/seed-user.mjs",
    "db:seed-suppliers": "node ./libs/db/scripts/seed-suppliers.mjs",
    "db:wipe": "docker exec certivo-postgres psql -U certivo -d certivo -c \"DROP SCHEMA IF EXISTS regulation_embeddings CASCADE; DROP SCHEMA IF EXISTS app_private CASCADE; DROP SCHEMA public CASCADE; CREATE SCHEMA public; GRANT ALL ON SCHEMA public TO certivo; GRANT ALL ON SCHEMA public TO public;\" && pnpm db:migrate",
    "lab:test": "node scripts/lab-smoke.mjs",
    "risk:test": "node scripts/risk-impact-smoke.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "devDependencies": {
    "@certivo/jobs-workflows": "workspace:*",
    "@eslint/js": "^9.39.1",
    "@temporalio/client": "^1.13.2",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitest/coverage-v8": "^4.0.10",
    "eslint": "^9.39.1",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.10"
  }
}
